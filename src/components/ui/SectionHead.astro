---
interface Props {
  id?: string;
  title: string;
  count?: string;
  class?: string;
}

const { id, title, count, class: className = '' } = Astro.props;
---

<div class:list={['mb-6 flex items-baseline justify-between', className]}>
  <h2
    id={id}
    class="font-mono text-[12px] font-medium tracking-[0.18em] text-[var(--color-fg-dim)] uppercase"
  >
    {title}
  </h2>
  {
    count && (
      <span class="font-mono text-[12px] tracking-[0.1em] text-[var(--color-fg-dim)]">{count}</span>
    )
  }
</div>
