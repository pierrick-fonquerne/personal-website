---
interface Props {
  class?: string;
}

const { class: className = 'h-[18px] w-[18px]' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M12 2.5 21 7v10l-9 4.5L3 17V7l9-4.5Z"></path>
  <path d="M3 7l9 4.5L21 7"></path>
  <path d="M12 11.5V21.5"></path>
  <path d="M7.5 4.75 16.5 9.25"></path>
</svg>
