---
interface Props {
  color?: 'success' | 'accent';
  class?: string;
}

const { color = 'success', class: className = '' } = Astro.props;

const colorVar = color === 'accent' ? 'var(--color-accent)' : 'var(--color-success)';
---

<span
  class:list={['pulse-dot inline-block rounded-full', className]}
  style={`--dot-color: ${colorVar}`}
  aria-hidden="true"></span>

<style>
  .pulse-dot {
    width: 7px;
    height: 7px;
    background: var(--dot-color);
    animation: pulse-out 2s ease-out infinite;
  }
  @keyframes pulse-out {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--dot-color) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 9px color-mix(in oklab, var(--dot-color) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--dot-color) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse-dot {
      animation: none;
    }
  }
</style>
