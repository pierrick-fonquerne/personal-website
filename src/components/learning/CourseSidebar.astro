---
import { localizedPath, type Locale } from '../../lib/i18n';

interface ModuleLink {
  slug: string;
  title: string;
  order: number;
}

interface Props {
  courseSlug: string;
  courseTitle: string;
  locale: Locale;
  modules: ModuleLink[];
  activeSlug?: string;
}

const { courseSlug, courseTitle, locale, modules, activeSlug } = Astro.props;
const courseHref = localizedPath(`/interactive-courses/${courseSlug}`, locale);
---

<aside class="sticky top-20 hidden h-fit w-[240px] shrink-0 lg:block">
  <a
    href={courseHref}
    class="block font-mono text-[11px] tracking-[0.18em] text-[var(--color-fg-dim)] uppercase hover:text-[var(--color-accent)]"
  >
    ← {courseTitle}
  </a>
  <ol class="mt-4 space-y-1">
    {
      modules.map((mod) => {
        const href = localizedPath(`/interactive-courses/${courseSlug}/${mod.slug}`, locale);
        const isActive = mod.slug === activeSlug;
        return (
          <li>
            <a
              href={href}
              class:list={[
                'flex gap-3 rounded-md px-2 py-1.5 font-mono text-[12px] transition-colors',
                isActive
                  ? 'bg-[var(--color-hover)] text-[var(--color-accent)]'
                  : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-hover)] hover:text-[var(--color-fg)]',
              ]}
            >
              <span class="text-[var(--color-fg-dim)] tabular-nums">
                {String(mod.order).padStart(2, '0')}
              </span>
              <span>{mod.title}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</aside>
