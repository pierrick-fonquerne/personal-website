---
type CalloutKind = 'info' | 'tip' | 'warn' | 'note';

interface Props {
  kind?: CalloutKind;
  title?: string;
}

const { kind = 'info', title } = Astro.props;

const KIND_STYLES: Record<CalloutKind, { border: string; accent: string; label: string }> = {
  info: {
    border: 'border-l-[var(--color-accent)]',
    accent: 'text-[var(--color-accent)]',
    label: 'INFO',
  },
  tip: {
    border: 'border-l-[var(--color-success)]',
    accent: 'text-[var(--color-success)]',
    label: 'ASTUCE',
  },
  warn: { border: 'border-l-amber-400', accent: 'text-amber-400', label: 'ATTENTION' },
  note: {
    border: 'border-l-[var(--color-fg-dim)]',
    accent: 'text-[var(--color-fg-dim)]',
    label: 'NOTE',
  },
};

const styles = KIND_STYLES[kind];
---

<aside
  class:list={[
    'my-6 rounded-r-md border-l-2 bg-[var(--color-bg-elevated)] px-5 py-4',
    styles.border,
  ]}
>
  <div
    class:list={[
      'mb-1 font-mono text-[11px] font-medium tracking-[0.18em] uppercase',
      styles.accent,
    ]}
  >
    {title ?? styles.label}
  </div>
  <div class="text-[15px] leading-relaxed text-[var(--color-fg)]">
    <slot />
  </div>
</aside>
