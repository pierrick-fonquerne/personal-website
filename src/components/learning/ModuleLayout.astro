---
import ChapterToolbar from './ChapterToolbar';
import ChapterAudioPlayer from './ChapterAudioPlayer';
import MathZoom from './MathZoom.astro';
import CodeCopy from './CodeCopy.astro';
import TermSheet from './TermSheet.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  badge: string;
  title: string;
  subtitle?: string;
  locale: Locale;
  courseSlug: string;
  moduleSlug: string;
  nextHref?: string;
  nextTitle?: string;
}

const { badge, title, subtitle, locale, courseSlug, moduleSlug, nextHref, nextTitle } = Astro.props;
const t = useTranslations(locale);

const audioLabels = {
  listen: t.toolbar.listen,
  pause: t.toolbar.pause,
  resume: t.toolbar.resume,
  stop: t.toolbar.stop,
  close: t.toolbar.close,
  speed: t.toolbar.speed,
  loading: t.toolbar.loading,
  error: t.toolbar.error,
  webSpeechBadge: t.toolbar.webSpeechBadge,
  mp3Badge: t.toolbar.mp3Badge,
  download: t.toolbar.download,
  skipBack: t.toolbar.skipBack,
  skipForward: t.toolbar.skipForward,
  nextChapterIn: t.toolbar.nextChapterIn,
  playNext: t.toolbar.playNext,
  cancel: t.toolbar.cancel,
  shortcuts: t.toolbar.shortcuts,
  shortcutsTitle: t.toolbar.shortcutsTitle,
  shortcutPlayPause: t.toolbar.shortcutPlayPause,
  shortcutSkipBack: t.toolbar.shortcutSkipBack,
  shortcutSkipForward: t.toolbar.shortcutSkipForward,
  shortcutFineSeek: t.toolbar.shortcutFineSeek,
  shortcutJump: t.toolbar.shortcutJump,
};
---

<article class="min-w-0 py-12">
  <header class="mb-10">
    <span
      class="inline-block font-mono text-[11px] font-medium tracking-[0.18em] text-[var(--color-accent)] uppercase"
    >
      {badge}
    </span>
    <h1
      class="font-display mt-3 text-[clamp(28px,6vw,40px)] leading-[1.15] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-fg-muted)]">{subtitle}</p>
      )
    }
  </header>
  <div
    class="sticky top-[112px] z-20 mb-8 flex flex-wrap items-center justify-end gap-2 lg:top-4"
    data-print="hide"
  >
    <ChapterToolbar client:idle labels={{ print: t.toolbar.print }} />
    <ChapterAudioPlayer
      client:idle
      locale={locale}
      courseSlug={courseSlug}
      moduleSlug={moduleSlug}
      contentSelector="#chapter-content"
      labels={audioLabels}
      chapterTitle={title}
      nextHref={nextHref}
      nextTitle={nextTitle}
    />
  </div>
  <div id="chapter-content" class="prose-module">
    <slot />
  </div>
</article>
<MathZoom zoomLabel={t.a11y.zoomEquation} closeLabel={t.a11y.closeZoom} />
<CodeCopy copyLabel={t.a11y.copyCode} copiedLabel={t.a11y.copiedCode} />
<TermSheet openGlossaryLabel={t.a11y.openGlossary} closeLabel={t.a11y.closeDefinition} />

<style>
  .prose-module :global(h2) {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-top: 2.4rem;
    margin-bottom: 0.8rem;
    color: var(--color-fg);
  }
  .prose-module :global(h3) {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    margin-top: 1.8rem;
    margin-bottom: 0.6rem;
    color: var(--color-fg);
  }
  .prose-module :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-fg);
    margin: 0.9rem 0;
  }
  .prose-module :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-module :global(strong) {
    font-weight: 600;
    color: var(--color-fg);
  }
  .prose-module :global(ul),
  .prose-module :global(ol) {
    padding-left: 1.4rem;
    margin: 0.9rem 0;
  }
  .prose-module :global(ul) {
    list-style: disc;
  }
  .prose-module :global(ol) {
    list-style: decimal;
  }
  .prose-module :global(li) {
    font-size: 16px;
    line-height: 1.7;
    margin: 0.3rem 0;
  }
  .prose-module :global(li::marker) {
    color: var(--color-fg-dim);
  }
  .prose-module :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.4rem 0;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose-module :global(table thead),
  .prose-module :global(table tbody) {
    display: table;
    width: 100%;
    min-width: 480px;
  }
  .prose-module :global(thead) {
    border-bottom: 1px solid var(--color-line-strong);
  }
  .prose-module :global(th) {
    padding: 0.55rem 0.9rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    font-weight: 600;
  }
  .prose-module :global(tbody tr) {
    border-bottom: 1px solid var(--color-line);
  }
  .prose-module :global(tbody tr:last-child) {
    border-bottom: 0;
  }
  .prose-module :global(td) {
    padding: 0.7rem 0.9rem;
    color: var(--color-fg);
    vertical-align: top;
  }
  .prose-module :global(td:first-child) {
    color: var(--color-fg);
    font-weight: 500;
  }
  .prose-module :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-bg-elevated);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
  .prose-module :global(pre) {
    margin: 1.2rem 0;
    padding: 1rem 1.2rem;
    border-radius: 6px;
    background:
      linear-gradient(to right, var(--color-bg-elevated), transparent) 0 0 / 28px 100% no-repeat,
      linear-gradient(to left, var(--color-bg-elevated), transparent) 100% 0 / 28px 100% no-repeat,
      radial-gradient(farthest-side at 0 50%, var(--color-accent-soft), transparent) 0 0 / 10px 100%
        no-repeat,
      radial-gradient(farthest-side at 100% 50%, var(--color-accent-soft), transparent) 100% 0 /
        10px 100% no-repeat;
    background-attachment: local, local, scroll, scroll;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .prose-module :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .prose-module :global(.code-block) {
    position: relative;
  }
  .prose-module :global(.code-copy) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      color 0.15s ease;
  }
  .prose-module :global(.code-block:hover .code-copy),
  .prose-module :global(.code-copy:focus-visible) {
    opacity: 1;
  }
  .prose-module :global(.code-copy.is-copied) {
    color: var(--color-success);
    border-color: var(--color-success);
    opacity: 1;
  }
  @media (pointer: coarse) {
    .prose-module :global(.code-copy) {
      opacity: 1;
    }
  }
  .prose-module :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 6px 12px;
    -webkit-overflow-scrolling: touch;
    background:
      linear-gradient(to right, var(--color-bg), transparent) 0 0 / 32px 100% no-repeat,
      linear-gradient(to left, var(--color-bg), transparent) 100% 0 / 32px 100% no-repeat,
      radial-gradient(farthest-side at 0 50%, var(--color-accent-soft), transparent) 0 0 / 12px 100%
        no-repeat,
      radial-gradient(farthest-side at 100% 50%, var(--color-accent-soft), transparent) 100% 0 /
        12px 100% no-repeat;
    background-attachment: local, local, scroll, scroll;
  }
  @media (max-width: 640px) {
    .prose-module :global(.katex-display) {
      text-align: left;
    }
  }
  @media (pointer: coarse) {
    .prose-module :global(.katex-display) {
      cursor: zoom-in;
    }
  }
  .prose-module :global(blockquote) {
    border-left: 2px solid var(--color-line-strong);
    padding-left: 1rem;
    color: var(--color-fg-muted);
    margin: 1.2rem 0;
    font-style: italic;
  }
  .prose-module :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin: 2.4rem 0;
  }
</style>
