---
interface Props {
  badge: string;
  title: string;
  subtitle?: string;
}

const { badge, title, subtitle } = Astro.props;
---

<article class="mx-auto max-w-[760px] px-6 py-12">
  <header class="mb-10">
    <span
      class="inline-block font-mono text-[11px] font-medium tracking-[0.18em] text-[var(--color-accent)] uppercase"
    >
      {badge}
    </span>
    <h1
      class="mt-3 font-display text-[40px] leading-[1.1] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-fg-muted)]">{subtitle}</p>
      )
    }
  </header>
  <div class="prose-module">
    <slot />
  </div>
</article>

<style>
  .prose-module :global(h2) {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-top: 2.4rem;
    margin-bottom: 0.8rem;
    color: var(--color-fg);
  }
  .prose-module :global(h3) {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    margin-top: 1.8rem;
    margin-bottom: 0.6rem;
    color: var(--color-fg);
  }
  .prose-module :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-fg);
    margin: 0.9rem 0;
  }
  .prose-module :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-module :global(strong) {
    font-weight: 600;
    color: var(--color-fg);
  }
  .prose-module :global(ul),
  .prose-module :global(ol) {
    padding-left: 1.4rem;
    margin: 0.9rem 0;
  }
  .prose-module :global(li) {
    font-size: 16px;
    line-height: 1.7;
    margin: 0.3rem 0;
  }
  .prose-module :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-bg-elevated);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
  .prose-module :global(pre) {
    margin: 1.2rem 0;
    padding: 1rem 1.2rem;
    border-radius: 6px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .prose-module :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .prose-module :global(blockquote) {
    border-left: 2px solid var(--color-line-strong);
    padding-left: 1rem;
    color: var(--color-fg-muted);
    margin: 1.2rem 0;
    font-style: italic;
  }
  .prose-module :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin: 2.4rem 0;
  }
</style>
