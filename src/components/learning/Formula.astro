---
interface Props {
  caption?: string;
  display?: boolean;
}

const { caption, display = true } = Astro.props;
---

<figure
  class:list={[
    'my-6 rounded-md border border-[var(--color-line)] bg-[var(--color-bg-elevated)] px-6 py-5',
    display ? 'text-center' : 'text-left',
  ]}
>
  <div class="font-mono text-[15px] leading-relaxed text-[var(--color-fg)]">
    <slot />
  </div>
  {
    caption && (
      <figcaption class="mt-3 font-mono text-[11px] tracking-[0.12em] text-[var(--color-fg-dim)] uppercase">
        {caption}
      </figcaption>
    )
  }
</figure>
