---
// Rendu conditionnel : ModuleLayout n'inclut ce composant que lorsque le
// chapitre contient effectivement des formules KaTeX (voir hasMath).
// L'import en ?url resout l'asset (fonts inclus) sans laisser Vite le
// fusionner dans un chunk CSS partage avec d'autres composants toujours
// rendus (ModuleNavMobile...) : le <link> n'est emis que sur les pages
// qui rendent reellement ce composant.
import katexHref from 'katex/dist/katex.min.css?url';
---

<link rel="stylesheet" href={katexHref} />
