---
import SectionHead from '../ui/SectionHead.astro';
import Timeline from './Timeline.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="journey"
  aria-labelledby="journey-heading"
  class="mx-auto mt-20 max-w-[1280px] px-14 pb-12"
>
  <SectionHead id="journey-heading" title={t.career.title} count={t.career.count} />
  <Timeline items={t.career.items} nowLabel={t.career.nowLabel} />
</section>
