---
import SectionHead from '../ui/SectionHead.astro';
import Timeline from './Timeline.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="education"
  aria-labelledby="education-heading"
  class="mx-auto mt-20 max-w-[1280px] px-14 pb-12"
>
  <SectionHead id="education-heading" title={t.education.title} count={t.education.count} />
  <Timeline items={t.education.items} />
</section>
