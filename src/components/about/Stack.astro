---
import SectionHead from '../ui/SectionHead.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="stack" aria-labelledby="stack-heading" class="mx-auto mt-20 max-w-[1280px] px-14">
  <SectionHead id="stack-heading" title={t.stack.title} count={t.stack.count} />

  <div
    class="grid grid-cols-1 gap-x-10 gap-y-6 border-t border-[var(--color-line)] py-10 sm:grid-cols-2 md:grid-cols-3"
  >
    {
      t.stack.groups.map((g) => (
        <div>
          <div class="mb-1.5 font-mono text-[11px] tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
            {g.category}
          </div>
          <div class="text-[15px] text-[var(--color-fg)]">{g.techs}</div>
        </div>
      ))
    }
  </div>
</section>
