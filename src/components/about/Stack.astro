---
import SectionHead from '../ui/SectionHead.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<SectionHead title={t.stack.title} count={t.stack.count} />

<div
  class="mx-auto grid max-w-[1280px] grid-cols-1 gap-x-10 gap-y-6 border-t border-[var(--color-line)] px-14 py-10 sm:grid-cols-2 md:grid-cols-3"
>
  {
    t.stack.groups.map((g) => (
      <div>
        <div class="mb-1.5 font-mono text-[11px] tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          {g.category}
        </div>
        <div class="text-[15px] text-[var(--color-fg)]">{g.techs}</div>
      </div>
    ))
  }
</div>
