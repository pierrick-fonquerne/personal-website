---
import { Image } from 'astro:assets';
import firefighter from '../../assets/firefighter.jpg';
import SectionHead from '../ui/SectionHead.astro';
import Timeline from './Timeline.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="beyond-work"
  aria-labelledby="beyond-work-heading"
  class="mx-auto mt-20 max-w-[1280px] px-14 pb-12"
>
  <SectionHead id="beyond-work-heading" title={t.beyondWork.title} count={t.beyondWork.count} />

  <div
    class="grid grid-cols-1 gap-12 border-t border-[var(--color-line)] pt-12 md:grid-cols-[360px_1fr]"
  >
    <figure class="portrait-wrap relative w-full max-w-[360px]">
      <div
        class="portrait-frame pointer-events-none absolute -inset-2 rounded-md border border-[var(--color-line)]"
      >
      </div>
      <div
        class="portrait relative overflow-hidden rounded-sm border border-[var(--color-line-strong)]"
        style="aspect-ratio: 4 / 5;"
      >
        <Image
          src={firefighter}
          alt={t.beyondWork.photoAlt}
          widths={[320, 560, 800]}
          sizes="(min-width: 768px) 360px, 80vw"
          loading="lazy"
          class="h-full w-full object-cover [filter:grayscale(0.15)_contrast(1.05)]"
        />
      </div>
      <figcaption
        class="mt-4 font-mono text-[11px] tracking-[0.12em] text-[var(--color-fg-dim)] uppercase"
      >
        [PHOTO · {t.beyondWork.photoYear}]
      </figcaption>
    </figure>

    <Timeline items={t.beyondWork.volunteering} nowLabel={t.beyondWork.nowLabel} />
  </div>

  <div class="mt-12 border-t border-[var(--color-line)] pt-8">
    <div class="mb-3 font-mono text-[11px] tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
      {t.beyondWork.interestsLabel}
    </div>
    <div class="flex flex-wrap gap-2">
      {
        t.beyondWork.interests.map((interest) => (
          <span class="inline-flex items-center rounded-full border border-[var(--color-line-strong)] px-3.5 py-1.5 font-mono text-[12px] tracking-[0.06em] text-[var(--color-fg)] uppercase">
            {interest}
          </span>
        ))
      }
    </div>
  </div>
</section>
