---
import Sun from '../ui/icons/Sun.astro';
import Moon from '../ui/icons/Moon.astro';

interface Props {
  ariaLabel?: string;
}

const { ariaLabel = 'Toggle theme' } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-[34px] w-[34px] cursor-pointer items-center justify-center rounded-lg border border-[var(--color-line-strong)] bg-transparent text-[var(--color-fg)] transition-colors duration-200 hover:bg-[var(--color-hover)]"
  aria-label={ariaLabel}
>
  <span class="icon-light"><Sun /></span>
  <span class="icon-dark hidden"><Moon /></span>
</button>

<style>
  :global([data-theme='light']) #theme-toggle .icon-light {
    display: none;
  }
  :global([data-theme='light']) #theme-toggle .icon-dark {
    display: inline-flex;
  }
</style>

<script>
  // Event delegation on document so the listener survives view transitions
  // (the button element is re-rendered on every navigation).
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('#theme-toggle')) return;

    const html = document.documentElement;
    const current = html.getAttribute('data-theme') ?? 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // localStorage unavailable, no-op
    }
  });
</script>
