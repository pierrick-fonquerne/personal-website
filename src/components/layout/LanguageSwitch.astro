---
import { LOCALES, switchLocalePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  ariaLabel?: string;
}

const { locale, ariaLabel = 'Switch language' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div
  class="inline-flex items-center gap-px rounded-md border border-[var(--color-line-strong)] p-[2px] font-mono text-[11px] uppercase"
  aria-label={ariaLabel}
>
  {
    LOCALES.map((l) => {
      const isActive = l === locale;
      const href = switchLocalePath(currentPath, locale, l);
      return (
        <a
          href={href}
          class:list={[
            'rounded-[3px] px-2 py-1 transition-colors duration-150',
            isActive
              ? 'bg-[var(--color-fg)] text-[var(--color-bg)]'
              : 'text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]',
          ]}
          aria-current={isActive ? 'true' : undefined}
        >
          {l}
        </a>
      );
    })
  }
</div>
