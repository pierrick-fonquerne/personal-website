---
import { LOCALES, resolveTranslatedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  ariaLabel?: string;
}

const { locale, ariaLabel = 'Switch language' } = Astro.props;
const currentPath = Astro.url.pathname;

const localeHrefs = await Promise.all(
  LOCALES.map(async (l) => ({
    locale: l,
    href: await resolveTranslatedPath(currentPath, locale, l),
  })),
);
---

<div
  class="inline-flex h-10 items-center gap-px rounded-md border border-[var(--color-line-strong)] p-[3px] font-mono text-[11px] uppercase"
  aria-label={ariaLabel}
>
  {
    localeHrefs.map(({ locale: l, href }) => {
      const isActive = l === locale;
      return (
        <a
          href={href}
          data-locale={l}
          aria-current={isActive ? 'true' : undefined}
          class:list={[
            'relative inline-flex h-full cursor-pointer items-center rounded-[4px] px-3 transition-colors duration-150',
            isActive
              ? 'text-[var(--color-bg)]'
              : 'text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]',
          ]}
        >
          {isActive && (
            <span
              transition:name="lang-pill"
              class="absolute inset-0 -z-0 rounded-[3px] bg-[var(--color-fg)]"
              aria-hidden="true"
            />
          )}
          <span class="relative z-10">{l}</span>
        </a>
      );
    })
  }
</div>

<script>
  // Persist the user's manual language choice so the language suggestion
  // banner stays hidden on future loads.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const anchor = target.closest<HTMLAnchorElement>('a[data-locale]');
    if (!anchor) return;
    const loc = anchor.getAttribute('data-locale');
    if (loc) {
      try {
        localStorage.setItem('lang', loc);
      } catch {
        // localStorage unavailable
      }
    }
  });
</script>
