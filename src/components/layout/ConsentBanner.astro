---
import { localizedPath, useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  umamiSiteId: string;
  umamiUrl: string;
}

const { locale, umamiSiteId, umamiUrl } = Astro.props;
const t = useTranslations(locale);
---

<div
  id="consent-banner"
  style="display:none"
  data-website-id={umamiSiteId}
  data-umami-url={umamiUrl}
  class="fixed bottom-0 left-0 right-0 z-50 border-t border-[var(--color-line)] bg-[var(--color-bg)] px-6 py-4"
  role="region"
  aria-label={locale === 'fr' ? 'Consentement analytics' : 'Analytics consent'}
>
  <div class="container-page flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-[var(--color-fg-muted)]">
      {t.consent.message}
      {' '}
      <a
        href={localizedPath('/legal', locale)}
        class="underline underline-offset-2 transition-colors duration-200 hover:text-[var(--color-accent)]"
      >
        {t.consent.learnMore}
      </a>
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        id="consent-decline"
        type="button"
        class="rounded-lg border border-[var(--color-line-strong)] px-4 py-1.5 text-sm text-[var(--color-fg-muted)] transition-colors duration-200 hover:bg-[var(--color-hover)]"
      >
        {t.consent.decline}
      </button>
      <button
        id="consent-accept"
        type="button"
        class="rounded-lg bg-[var(--color-accent)] px-4 py-1.5 text-sm font-medium text-white transition-opacity duration-200 hover:opacity-80"
      >
        {t.consent.accept}
      </button>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'analytics-consent';

  function injectUmami() {
    if (window.__umamiLoaded) return;
    const banner = document.getElementById('consent-banner') as HTMLElement | null;
    const websiteId = banner?.dataset.websiteId;
    const umamiUrl = banner?.dataset.umamiUrl;
    if (!websiteId || !umamiUrl) return;
    window.__umamiLoaded = true;
    const s = document.createElement('script');
    s.defer = true;
    s.src = `${umamiUrl}/script.js`;
    s.dataset.websiteId = websiteId;
    document.head.appendChild(s);
  }

  function init() {
    const banner = document.getElementById('consent-banner') as HTMLElement | null;
    if (!banner) return;
    try {
      const consent = localStorage.getItem(CONSENT_KEY);
      if (consent === 'accepted') {
        injectUmami();
      } else if (!consent) {
        banner.style.display = '';
      }
    } catch {
      /* localStorage unavailable */
    }
  }

  // Reset before each navigation so Umami is re-injected on the new page
  document.addEventListener('astro:before-swap', () => {
    window.__umamiLoaded = false;
  });

  // Event delegation on document - survives view transitions (same pattern as ThemeToggle)
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    const banner = document.getElementById('consent-banner') as HTMLElement | null;
    if (target.closest('#consent-accept')) {
      try {
        localStorage.setItem(CONSENT_KEY, 'accepted');
      } catch {
        /* localStorage unavailable */
      }
      if (banner) banner.style.display = 'none';
      injectUmami();
    } else if (target.closest('#consent-decline')) {
      try {
        localStorage.setItem(CONSENT_KEY, 'declined');
      } catch {
        /* localStorage unavailable */
      }
      if (banner) banner.style.display = 'none';
    }
  });

  document.addEventListener('astro:page-load', init);
  init();
</script>
