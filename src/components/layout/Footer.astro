---
import { NAV_LINKS, SITE } from '../../lib/links';
import Github from '../ui/icons/Github.astro';
import LinkedIn from '../ui/icons/LinkedIn.astro';
import Mail from '../ui/icons/Mail.astro';
import Rss from '../ui/icons/Rss.astro';

const siteVersion = 'v2026.05';
---

<footer class="mt-20 border-t border-[var(--color-line)] px-14 pt-16 pb-10">
  <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
    <!-- Colophon -->
    <div>
      <h4
        class="mb-3.5 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase"
      >
        // Colophon
      </h4>
      <p class="max-w-[36ch] text-[15px] leading-[1.55] text-[var(--color-fg-muted)]">
        This site is hand-built. No trackers, no analytics, no popups. Just code. Astro · Tailwind
        · MDX.
      </p>
    </div>

    <!-- Site -->
    <div>
      <h4
        class="mb-3.5 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase"
      >
        // Site
      </h4>
      <ul class="flex flex-col gap-2 text-sm text-[var(--color-fg-muted)]">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="transition-colors duration-200 hover:text-[var(--color-accent)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Elsewhere -->
    <div>
      <h4
        class="mb-3.5 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase"
      >
        // Elsewhere
      </h4>
      <ul class="flex flex-col gap-2 text-sm text-[var(--color-fg-muted)]">
        <li>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 transition-colors duration-200 hover:text-[var(--color-accent)]"
          >
            <Github class="h-[14px] w-[14px] opacity-70" />
            github.com/pierrick-fonquerne
          </a>
        </li>
        <li>
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 transition-colors duration-200 hover:text-[var(--color-accent)]"
          >
            <LinkedIn class="h-[14px] w-[14px] opacity-70" />
            linkedin.com/in/pierrickfonquerne
          </a>
        </li>
        <li>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-2 transition-colors duration-200 hover:text-[var(--color-accent)]"
          >
            <Rss class="h-[14px] w-[14px] opacity-70" />
            RSS feed
          </a>
        </li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h4
        class="mb-3.5 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase"
      >
        // Contact
      </h4>
      <ul class="flex flex-col gap-2 text-sm text-[var(--color-fg-muted)]">
        <li>
          <a
            href={`mailto:${SITE.email}`}
            class="inline-flex items-center gap-2 transition-colors duration-200 hover:text-[var(--color-accent)]"
          >
            <Mail class="h-[14px] w-[14px] opacity-70" />
            {SITE.email}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div
    class="flex flex-col items-start justify-between gap-3 border-t border-[var(--color-line)] pt-6 font-mono text-[11px] tracking-[0.1em] text-[var(--color-fg-dim)] md:flex-row md:items-center"
  >
    <div>© {new Date().getFullYear()} {SITE.name.toUpperCase()}</div>
    <div class="text-[var(--color-fg-muted)]">{siteVersion}</div>
  </div>
</footer>
