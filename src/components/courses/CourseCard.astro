---
interface Props {
  href: string;
  level: string;
  moduleCount: number;
  estimatedMinutes: number;
  title: string;
  summary: string;
  tags: string[];
  modulesUnit: string;
  minutesUnit: string;
}

const { href, level, moduleCount, estimatedMinutes, title, summary, tags, modulesUnit, minutesUnit } =
  Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-md border border-[var(--color-line)] bg-[var(--color-bg-elevated)] p-4 transition-colors hover:border-[var(--color-line-strong)]"
>
  <div
    class="flex items-center gap-2 font-mono text-[11px] tracking-[0.14em] text-[var(--color-fg-dim)] uppercase"
  >
    <span>{level}</span>
    <span aria-hidden="true">·</span>
    <span>{moduleCount} {modulesUnit}</span>
    <span aria-hidden="true">·</span>
    <span>{estimatedMinutes} {minutesUnit}</span>
  </div>
  <h4
    class="font-display mt-2 text-[16px] font-bold tracking-[-0.01em] text-[var(--color-fg)] group-hover:text-[var(--color-accent)]"
  >
    {title}
  </h4>
  <p class="mt-2 line-clamp-2 text-[13px] leading-relaxed text-[var(--color-fg-muted)]">
    {summary}
  </p>
  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded border border-[var(--color-line)] px-2 py-0.5 font-mono text-[10px] tracking-[0.08em] text-[var(--color-fg-dim)] uppercase">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</a>
