---
import type { CollectionEntry } from 'astro:content';
import { localizedPath, useTranslations, type Locale } from '../../lib/i18n';
import Github from '../ui/icons/Github.astro';
import Crates from '../ui/icons/Crates.astro';
import ExternalLink from '../ui/icons/ExternalLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const content = project.data[locale];
const detailHref = localizedPath(`/projects/${project.data.slug}`, locale);
const isArchived = project.data.status === 'archived' || project.data.status === 'dormant';
---

<article
  class:list={[
    'group relative flex h-full flex-col gap-5 rounded-md border p-6 transition-colors duration-200',
    project.data.featured
      ? 'border-[var(--color-accent)]'
      : 'border-[var(--color-line)] hover:border-[var(--color-line-strong)]',
    isArchived && 'opacity-75',
  ]}
>
  <header class="flex flex-col gap-3">
    <div class="flex items-center justify-between gap-3">
      <span
        class:list={[
          'font-mono text-[11px] tracking-[0.16em] uppercase',
          project.data.status === 'active'
            ? 'text-[var(--color-accent)]'
            : 'text-[var(--color-fg-dim)]',
        ]}
      >
        {t.projects.statuses[project.data.status]}
      </span>
      <span class="font-mono text-[11px] tracking-[0.1em] text-[var(--color-fg-dim)]">
        {project.data.period}
      </span>
    </div>

    <h4 class="font-display text-[24px] leading-[1.15] font-bold tracking-[-0.01em]">
      <a
        href={detailHref}
        class="text-[var(--color-fg)] transition-colors duration-200 hover:text-[var(--color-accent)] focus-visible:text-[var(--color-accent)] focus-visible:outline-none"
      >
        {content.title}
      </a>
    </h4>

    <p class="text-[15px] leading-[1.5] text-[var(--color-fg-muted)]">
      {content.tagline}
    </p>
  </header>

  {
    project.data.stack.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {project.data.stack.map((tech) => (
          <li class="rounded-sm border border-[var(--color-line)] px-2 py-1 font-mono text-[11px] tracking-[0.05em] text-[var(--color-fg-dim)]">
            {tech}
          </li>
        ))}
      </ul>
    )
  }

  {
    project.data.links.length > 0 && (
      <footer class="mt-auto flex flex-wrap gap-2 border-t border-[var(--color-line)] pt-4">
        {project.data.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-[var(--color-line)] px-3 py-1.5 font-mono text-[11px] tracking-[0.06em] text-[var(--color-fg-muted)] uppercase transition-colors duration-200 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
            aria-label={`${content.title} — ${link.label}`}
          >
            {link.type === 'repo' && <Github class="h-[12px] w-[12px]" />}
            {link.type === 'crates' && <Crates class="h-[12px] w-[12px]" />}
            {(link.type === 'site' || link.type === 'docs' || link.type === 'demo') && (
              <ExternalLink class="h-[12px] w-[12px]" />
            )}
            {link.label}
          </a>
        ))}
      </footer>
    )
  }
</article>
