---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import CategoryHeading from '../ui/CategoryHeading.astro';
import ResearchCard from './ResearchCard.astro';

interface Props {
  entries: CollectionEntry<'research'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const t = useTranslations(locale);

const THEME_ORDER = [
  'architecture',
  'math',
  'ai',
  'systems',
  'data',
  'security',
  'network',
  'quant',
  'tooling',
] as const;
type Theme = (typeof THEME_ORDER)[number];

const STATUS_WEIGHT: Record<CollectionEntry<'research'>['data']['status'], number> = {
  published: 0,
  wip: 1,
  draft: 2,
  archived: 3,
};

function sortEntries(items: CollectionEntry<'research'>[]) {
  return [...items].sort((a, b) => {
    const statusDelta = STATUS_WEIGHT[a.data.status] - STATUS_WEIGHT[b.data.status];
    if (statusDelta !== 0) return statusDelta;

    const dateDelta = b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
    if (dateDelta !== 0) return dateDelta;

    return a.data.slug.localeCompare(b.data.slug);
  });
}

const visibleEntries = entries.filter((e) => e.data.status !== 'archived');

interface ProgramGroup {
  program: string;
  items: CollectionEntry<'research'>[];
}

interface DomainGroup {
  theme: Theme;
  total: number;
  free: CollectionEntry<'research'>[];
  programs: ProgramGroup[];
}

const groups: DomainGroup[] = THEME_ORDER.map((theme) => {
  const inTheme = visibleEntries.filter((e) => e.data.theme === theme);
  const free = sortEntries(inTheme.filter((e) => !e.data.subtheme));

  const byProgram = new Map<string, CollectionEntry<'research'>[]>();
  for (const entry of inTheme) {
    const program = entry.data.subtheme;
    if (!program) continue;
    const bucket = byProgram.get(program) ?? [];
    bucket.push(entry);
    byProgram.set(program, bucket);
  }

  const programs: ProgramGroup[] = [...byProgram.entries()]
    .map(([program, items]) => ({ program, items: sortEntries(items) }))
    .sort((a, b) => a.program.localeCompare(b.program, locale));

  return { theme: theme as Theme, total: inTheme.length, free, programs };
}).filter((group) => group.total > 0);
---

{
  groups.length === 0 ? (
    <div class="rounded-md border border-dashed border-[var(--color-line)] p-10 text-center">
      <p class="font-mono text-[12px] tracking-[0.1em] text-[var(--color-fg-dim)] uppercase">
        {t.research.emptyState}
      </p>
    </div>
  ) : (
    <div class="flex flex-col gap-20">
      {groups.map((group) => (
        <section aria-labelledby={`research-${group.theme}`}>
          <CategoryHeading
            id={`research-${group.theme}`}
            title={t.themes[group.theme]}
            count={t.research.count(group.total)}
          />

          {group.free.length > 0 && (
            <div class="mt-8" aria-label={t.research.freeFlow}>
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                {group.free.map((entry) => (
                  <ResearchCard entry={entry} locale={locale} />
                ))}
              </div>
            </div>
          )}

          {group.programs.map((prog) => (
            <div class="mt-12">
              <div class="mb-6 flex items-center gap-4">
                <span class="font-mono text-[12px] tracking-[0.16em] text-[var(--color-fg)] uppercase">
                  {prog.program}
                </span>
                <span class="h-px flex-1 bg-[var(--color-line)]" />
                <span class="font-mono text-[11px] tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
                  {t.research.count(prog.items.length)}
                </span>
              </div>
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                {prog.items.map((entry) => (
                  <ResearchCard entry={entry} locale={locale} />
                ))}
              </div>
            </div>
          ))}
        </section>
      ))}
    </div>
  )
}
