---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import type { ResolvedProgram } from '../../lib/programs';
import CategoryHeading from '../ui/CategoryHeading.astro';
import ResearchCard from './ResearchCard.astro';
import ProgramCard from './ProgramCard.astro';

interface Props {
  entries: CollectionEntry<'research'>[];
  programs: ResolvedProgram[];
  locale: Locale;
}

const { entries, programs, locale } = Astro.props;
const t = useTranslations(locale);

const THEME_ORDER = [
  'architecture',
  'math',
  'ai',
  'systems',
  'data',
  'security',
  'network',
  'quant',
  'tooling',
] as const;
type Theme = (typeof THEME_ORDER)[number];

const STATUS_WEIGHT: Record<CollectionEntry<'research'>['data']['status'], number> = {
  published: 0,
  wip: 1,
  draft: 2,
  archived: 3,
};

function sortEntries(items: CollectionEntry<'research'>[]) {
  return [...items].sort((a, b) => {
    const statusDelta = STATUS_WEIGHT[a.data.status] - STATUS_WEIGHT[b.data.status];
    if (statusDelta !== 0) return statusDelta;

    const dateDelta = b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
    if (dateDelta !== 0) return dateDelta;

    return a.data.slug.localeCompare(b.data.slug);
  });
}

const visibleEntries = entries.filter((e) => e.data.status !== 'archived');

const dossierSlugs = new Set<string>();
for (const program of programs) {
  for (const entry of program.toc) dossierSlugs.add(entry.data.slug);
  for (const entry of program.concepts) dossierSlugs.add(entry.data.slug);
}

interface DomainGroup {
  theme: Theme;
  free: CollectionEntry<'research'>[];
  programs: ResolvedProgram[];
}

const groups: DomainGroup[] = THEME_ORDER.map((theme) => {
  const free = sortEntries(
    visibleEntries.filter(
      (e) => e.data.theme === theme && !e.data.subtheme && !dossierSlugs.has(e.data.slug),
    ),
  );
  const themePrograms = programs.filter((p) => p.entry.data.theme === theme);
  return { theme: theme as Theme, free, programs: themePrograms };
}).filter((group) => group.free.length > 0 || group.programs.length > 0);
---

{
  groups.length === 0 ? (
    <div class="rounded-md border border-dashed border-[var(--color-line)] p-10 text-center">
      <p class="font-mono text-[12px] tracking-[0.1em] text-[var(--color-fg-dim)] uppercase">
        {t.research.emptyState}
      </p>
    </div>
  ) : (
    <div class="flex flex-col gap-20">
      {groups.map((group) => (
        <section aria-labelledby={`research-${group.theme}`}>
          <CategoryHeading
            id={`research-${group.theme}`}
            title={t.themes[group.theme]}
            count={t.research.count(group.free.length + group.programs.length)}
          />

          {group.free.length > 0 && (
            <div class="mt-8" aria-label={t.research.freeFlow}>
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                {group.free.map((entry) => (
                  <ResearchCard entry={entry} locale={locale} />
                ))}
              </div>
            </div>
          )}

          {group.programs.length > 0 && (
            <div class="mt-12">
              <div class="mb-6 flex items-center gap-4">
                <span class="font-mono text-[12px] tracking-[0.16em] text-[var(--color-fg)] uppercase">
                  {t.research.programsLabel}
                </span>
                <span class="h-px flex-1 bg-[var(--color-line)]" />
              </div>
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                {group.programs.map((program) => (
                  <ProgramCard program={program} locale={locale} />
                ))}
              </div>
            </div>
          )}
        </section>
      ))}
    </div>
  )
}
