---
import Eyebrow from '../ui/Eyebrow.astro';
import PulseDot from '../ui/PulseDot.astro';
import RoleRotator from './RoleRotator.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const m = t.hero.meta;
const cells = [
  { label: m.role, value: m.values.role },
  { label: m.focus, value: m.values.focus, accent: true },
  { label: m.based, value: m.values.based },
  { label: m.status, value: m.values.status, status: true },
];
---

<section class="mx-auto max-w-[1280px] px-14 pt-24 pb-12">
  <Eyebrow text={t.hero.eyebrow} />

  <h1
    class="bigname font-display mt-14 text-[clamp(72px,12vw,180px)] leading-[0.85] font-extrabold tracking-[-0.06em] text-[var(--color-fg)] uppercase"
  >
    <span class="word w1"><span>Pierrick</span></span><br />
    <span class="word w2"><span>Fonquerne</span></span>
  </h1>

  <RoleRotator label={t.hero.iAmLabel} roles={t.hero.roles} />

  <p class="fade-up mt-9 max-w-[720px] text-[22px] leading-[1.45] text-[var(--color-fg-muted)]">
    {t.hero.tagline}
  </p>

  <div
    class="fade-up grid-info mt-[72px] grid grid-cols-1 gap-6 border-t border-[var(--color-line)] pt-7 sm:grid-cols-2 md:grid-cols-4"
  >
    {
      cells.map((cell) => (
        <div>
          <div class="mb-2 font-mono text-[11px] tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
            {cell.label}
          </div>
          <div
            class:list={[
              'text-[15px] text-[var(--color-fg)]',
              cell.accent && 'text-[var(--color-accent)]',
            ]}
          >
            {cell.status && <PulseDot color="success" class="mr-2 align-middle" />}
            {cell.value}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }
  .word > span {
    display: inline-block;
    transform: translateY(110%);
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) forwards;
  }
  .word.w1 > span {
    animation-delay: 0.15s;
  }
  .word.w2 > span {
    animation-delay: 0.3s;
  }
  @keyframes rise {
    to {
      transform: translateY(0);
    }
  }

  .fade-up {
    opacity: 0;
    transform: translateY(12px);
    animation: fade-up 0.7s forwards ease-out;
  }
  .grid-info {
    animation-delay: 1.1s;
  }
  p.fade-up {
    animation-delay: 0.9s;
  }
  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word > span {
      transform: none;
      animation: none;
    }
    .fade-up {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
