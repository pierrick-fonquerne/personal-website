---
import '../styles/globals.css';
import '../styles/print.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import LanguageSuggestBanner from '../components/layout/LanguageSuggestBanner.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import type { Thing } from 'schema-dts';
import { Font } from 'astro:assets';
import {
  getLocaleFromUrl,
  LOCALES,
  switchLocalePath,
  useTranslations,
  type Locale,
} from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: string;
  locale?: Locale;
  schema?: readonly Thing[];
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  current,
  locale = getLocaleFromUrl(Astro.url),
  schema = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const t = useTranslations(locale);
const resolvedDescription = description ?? t.meta.description;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-jetbrains" />

    <title>{title}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonicalURL} />
    <StructuredData locale={locale} extra={schema} />

    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(switchLocalePath(Astro.url.pathname, locale, l), Astro.site).toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocalePath(Astro.url.pathname, locale, 'en'), Astro.site).toString()}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Pierrick Fonquerne, cours et recherche"
      href={new URL('/rss.xml', Astro.site).toString()}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:site_name" content="Pierrick Fonquerne" />
    {
      ogImage === '/og-default.png' && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />

    <ClientRouter />

    {
      /* Apply the stored theme before paint and on every view-transition swap.
        Without astro:before-swap, ClientRouter resets <html data-theme> back to
        the SSR default whenever the user navigates (e.g. switches language). */
    }
    <script is:inline>
      (() => {
        const apply = (doc) => {
          try {
            const stored = localStorage.getItem('theme');
            const preferred = window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
            const theme = stored ?? preferred;
            (doc || document).documentElement.setAttribute('data-theme', theme);
          } catch {
            /* localStorage unavailable */
          }
        };
        apply();
        document.addEventListener('astro:before-swap', (event) => apply(event.newDocument));
      })();
    </script>
  </head>
  <body class="relative">
    <a href="#main-content" class="skip-link">{t.a11y.skipToContent}</a>
    <ScrollProgress />
    <header>
      <Nav locale={locale} current={current} />
    </header>
    <main id="main-content" tabindex="-1" class="relative z-[3]">
      <slot />
    </main>
    <Footer locale={locale} />
    <ConsentBanner
      locale={locale}
      umamiSiteId={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? ''}
      umamiUrl={import.meta.env.PUBLIC_UMAMI_URL ?? ''}
    />
    <LanguageSuggestBanner locale={locale} />
  </body>
</html>
