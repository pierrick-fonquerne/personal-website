---
import '../styles/globals.css';
import '../styles/print.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import {
  getLocaleFromUrl,
  LOCALES,
  switchLocalePath,
  useTranslations,
  type Locale,
} from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: string;
  locale?: Locale;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  current,
  locale = getLocaleFromUrl(Astro.url),
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const t = useTranslations(locale);
const resolvedDescription = description ?? t.meta.description;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonicalURL} />

    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(switchLocalePath(Astro.url.pathname, locale, l), Astro.site).toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocalePath(Astro.url.pathname, locale, 'en'), Astro.site).toString()}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />

    <ClientRouter />

    {/* First-visit language detection: redirect non-FR browsers from / to /en/.
        After redirect or first FR visit, the choice is persisted in localStorage
        so this block is a no-op on later loads (and the manual switcher always wins). */}
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('lang')) return;
          const onEn = location.pathname.startsWith('/en');
          const browserFr = (navigator.language || 'fr').toLowerCase().startsWith('fr');
          if (browserFr) {
            localStorage.setItem('lang', 'fr');
            return;
          }
          localStorage.setItem('lang', 'en');
          if (!onEn) {
            const sub = location.pathname === '/' ? '/' : location.pathname;
            location.replace('/en' + (sub === '/' ? '/' : sub));
          }
        } catch {
          /* navigator or localStorage unavailable, do nothing */
        }
      })();
    </script>

    {/* Apply the stored theme before paint and on every view-transition swap.
        Without astro:before-swap, ClientRouter resets <html data-theme> back to
        the SSR default whenever the user navigates (e.g. switches language). */}
    <script is:inline>
      (() => {
        const apply = (doc) => {
          try {
            const stored = localStorage.getItem('theme');
            const preferred = window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
            const theme = stored ?? preferred;
            (doc || document).documentElement.setAttribute('data-theme', theme);
          } catch {
            /* localStorage unavailable */
          }
        };
        apply();
        document.addEventListener('astro:before-swap', (event) => apply(event.newDocument));
      })();
    </script>
  </head>
  <body class="relative">
    <a href="#main-content" class="skip-link">{t.a11y.skipToContent}</a>
    <ScrollProgress />
    <header>
      <Nav locale={locale} current={current} />
    </header>
    <main id="main-content" tabindex="-1" class="relative z-[3]">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
