---
import '../styles/globals.css';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import { getLocaleFromUrl, LOCALES, switchLocalePath, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: string;
  locale?: Locale;
}

const {
  title,
  description = 'Pierrick Fonquerne — passionate developer. Projects, writing and research.',
  ogImage = '/og-default.png',
  current,
  locale = getLocaleFromUrl(Astro.url),
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(switchLocalePath(Astro.url.pathname, locale, l), Astro.site).toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocalePath(Astro.url.pathname, locale, 'en'), Astro.site).toString()}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />

    {/* Restore saved theme before paint — avoids FOUC on initial render */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const preferred = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
          const theme = stored ?? preferred;
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          /* localStorage unavailable */
        }
      })();
    </script>
  </head>
  <body class="relative">
    <ScrollProgress />
    <Nav locale={locale} current={current} />
    <main class="relative z-[3]">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
