---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import About from '../../components/about/About.astro';
import { localizedPath, useTranslations } from '../../lib/i18n';
import { buildProfilePageNode } from '../../lib/seo';

const locale = 'fr' as const;
const t = useTranslations(locale);
const schema = [buildProfilePageNode(locale, localizedPath('/about', locale))];
---

<BaseLayout
  title={`${t.about.indexTitle} · Pierrick Fonquerne`}
  description="Parcours, compétences et engagements de Pierrick Fonquerne, développeur full-stack basé à Limoux."
  current="/about"
  locale={locale}
  schema={schema}
>
  <section class="container-page py-16">
    <Eyebrow text={t.about.eyebrow} />
    <h1
      class="font-display mt-4 text-[clamp(28px,6vw,44px)] leading-[1.1] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
    >
      {t.about.indexTitle}
    </h1>
  </section>

  <About locale={locale} standalone />
</BaseLayout>
