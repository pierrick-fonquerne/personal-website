---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '../../../../lib/i18n';
import { journalEntriesFor } from '../../../../lib/research-journal';

const locale = 'fr' as const;

export const getStaticPaths = (async () => {
  const research = (await getCollection('research')).filter((e) => e.data.published);
  const journal = (await getCollection('research-journal')).filter((e) => e.data.published);
  const paths: { params: { slug: string; entry: string }; props: { research: (typeof research)[number]; entry: (typeof journal)[number] } }[] = [];
  for (const r of research) {
    for (const e of journalEntriesFor(r.data.slug, journal)) {
      paths.push({ params: { slug: r.data.slug, entry: e.data.slug }, props: { research: r, entry: e } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { research, entry } = Astro.props;
const t = useTranslations(locale);
const body = await getEntry('research-journal-fr', entry.data.slug);
const Body = body ? (await render(body)).Content : null;
const title = entry.data.title[locale];
const dateLabel = entry.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={`${title} | Pierrick Fonquerne`}
  description={entry.data.excerpt?.[locale] ?? title}
  current="/research"
  locale={locale}
>
  <article class="mx-auto mt-8 max-w-[1280px] px-14 pb-24">
    <a
      href={localizedPath(`/research/${research.data.slug}/journal`, locale)}
      class="inline-flex items-center font-mono text-[12px] tracking-[0.06em] text-[var(--color-fg-dim)] uppercase transition-colors duration-200 hover:text-[var(--color-accent)]"
    >
      {t.research.journal.backToJournal}
    </a>

    <header class="mt-10 border-t border-[var(--color-line)] pt-10">
      <p class="font-mono text-[11px] tracking-[0.1em] text-[var(--color-fg-dim)]">
        <time datetime={entry.data.date.toISOString()}>{t.research.journal.dateLabel} {dateLabel}</time>
      </p>
      <h1
        class="font-display mt-5 text-[clamp(40px,6vw,72px)] leading-[1.05] font-extrabold tracking-[-0.03em] text-[var(--color-fg)]"
      >
        {title}
      </h1>
    </header>

    {
      Body && (
        <section class="prose-research mt-16 border-t border-[var(--color-line)] pt-12 text-[17px] leading-[1.7] text-[var(--color-fg)]">
          <Body />
        </section>
      )
    }
  </article>
</BaseLayout>
