---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import { listCourses } from '../../lib/courses';
import { localizedPath, useTranslations } from '../../lib/i18n';
import { SUBTHEMES_BY_THEME, THEMES } from '../../lib/taxonomy';

const locale = 'fr' as const;
const t = useTranslations(locale);
const courses = await listCourses(locale);

const groups = THEMES.map((theme) => ({
  theme,
  themeLabel: t.themes[theme],
  subthemes: SUBTHEMES_BY_THEME[theme]
    .map((sub) => ({
      sub,
      subLabel: t.subthemes[sub] ?? sub,
      courses: courses.filter((c) => c.data.theme === theme && c.data.subtheme === sub),
    }))
    .filter((s) => s.courses.length > 0),
})).filter((g) => g.subthemes.length > 0);
---

<BaseLayout
  title={`${t.courses.indexTitle} · Pierrick Fonquerne`}
  description={t.courses.indexLead}
  current="/interactive-courses"
  locale={locale}
>
  <section class="container-page py-16">
    <Eyebrow text={t.courses.eyebrow} />
    <h1
      class="font-display mt-4 text-[clamp(28px,6vw,44px)] leading-[1.1] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
    >
      {t.courses.indexTitle}
    </h1>
    <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-fg-muted)]">
      {t.courses.indexLead}
    </p>

    <a
      href="/glossary"
      class="mt-6 inline-block font-mono text-[12px] tracking-[0.14em] text-[var(--color-accent)] uppercase hover:underline"
    >
      {t.courses.glossaryLink}
    </a>

    <aside
      class="mt-8 rounded-md border border-l-4 border-[var(--color-line)] border-l-[var(--color-accent)] bg-[var(--color-bg-elevated)] p-4 text-[13px] leading-relaxed text-[var(--color-fg-muted)]"
    >
      <p>
        <strong class="text-[var(--color-fg)]">À propos de ces cours.</strong>{' '}
        Ces cours, bien que relus avec soin, sont issus de notes prises au fil de discussions avec divers
        modèles d'IA. Des erreurs subtiles ont pu y glisser malgré la relecture. Si tu en repères une,
        signale-la moi : <a
          href="mailto:contact@pierrickfonquerne.com"
          class="underline hover:text-[var(--color-accent)]">contact@pierrickfonquerne.com</a
        >.
      </p>
      <p class="mt-3">
        Les audios qui accompagnent les chapitres sont générés à partir d'un échantillon de ma
        propre voix, via Voxtral (Mistral AI). Pour les curieux qui voudraient écouter la version
        anglaise, je m'excuse d'avance pour mon terrible accent.
      </p>
    </aside>

    <div class="mt-20 space-y-24">
      {
        groups.map(({ theme, themeLabel, subthemes }) => (
          <section aria-labelledby={`theme-${theme}`}>
            <header class="mb-10 border-b border-[var(--color-line)] pb-4">
              <h2
                id={`theme-${theme}`}
                class="font-display text-[clamp(24px,5vw,36px)] leading-[1.15] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
              >
                {themeLabel}
              </h2>
            </header>

            <div class="space-y-12">
              {subthemes.map(({ sub, subLabel, courses: subCourses }) => (
                <div>
                  <h3
                    id={`sub-${sub}`}
                    class="mb-5 font-mono text-[12px] tracking-[0.18em] text-[var(--color-accent)] uppercase"
                  >
                    {subLabel}
                  </h3>
                  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {subCourses.map((course) => {
                      const href = localizedPath(
                        `/interactive-courses/${course.data.slug}`,
                        locale,
                      );
                      return (
                        <li>
                          <a
                            href={href}
                            class="group flex h-full flex-col rounded-md border border-[var(--color-line)] bg-[var(--color-bg-elevated)] p-5 transition-colors hover:border-[var(--color-line-strong)]"
                          >
                            <div class="flex items-center gap-2 font-mono text-[11px] tracking-[0.14em] text-[var(--color-fg-dim)] uppercase">
                              <span>{course.data.level}</span>
                              <span aria-hidden="true">·</span>
                              <span>
                                {course.data.modules.length} {t.courses.modulesUnit}
                              </span>
                              <span aria-hidden="true">·</span>
                              <span>
                                {course.data.estimatedMinutes} {t.courses.minutesUnit}
                              </span>
                            </div>
                            <h4 class="font-display mt-3 text-[20px] font-bold tracking-[-0.01em] text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">
                              {course.data.title}
                            </h4>
                            <p class="mt-2 text-[14px] leading-relaxed text-[var(--color-fg-muted)]">
                              {course.data.summary}
                            </p>
                            {course.data.tags.length > 0 && (
                              <ul class="mt-4 flex flex-wrap gap-1.5">
                                {course.data.tags.map((tag) => (
                                  <li class="rounded border border-[var(--color-line)] px-2 py-0.5 font-mono text-[10px] tracking-[0.08em] text-[var(--color-fg-dim)] uppercase">
                                    {tag}
                                  </li>
                                ))}
                              </ul>
                            )}
                            <span class="mt-5 font-mono text-[12px] tracking-[0.14em] text-[var(--color-accent)] uppercase opacity-0 transition-opacity group-hover:opacity-100">
                              {t.courses.cardCta} →
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
