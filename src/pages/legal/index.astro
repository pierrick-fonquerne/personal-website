---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../lib/i18n';

const locale = 'fr' as const;
const t = useTranslations(locale);
---

<BaseLayout title={t.legal.indexTitle} locale={locale}>
  <div class="container-page py-16 md:py-24">

    <header class="mb-16 max-w-2xl">
      <p class="mb-4 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
        Legal
      </p>
      <h1 class="mb-3 text-2xl font-semibold text-[var(--color-fg)]">
        {t.legal.indexTitle}
      </h1>
      <p class="text-sm text-[var(--color-fg-dim)]">Dernière mise à jour : mai 2026</p>
    </header>

    <div class="max-w-2xl space-y-14">

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Éditeur du site
        </p>
        <div class="space-y-1 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          <p>Pierrick Fonquerne</p>
          <p>Particulier - Limoux, Aude, France</p>
          <p>
            Contact :
            <a href="mailto:contact@pierrickfonquerne.com" class="text-[var(--color-accent)] transition-colors hover:underline">
              contact@pierrickfonquerne.com
            </a>
          </p>
        </div>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Directeur de la publication
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">Pierrick Fonquerne</p>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Hébergement
        </p>
        <div class="space-y-1 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          <p>OVH SAS - 2 rue Kellermann, 59100 Roubaix, France</p>
          <p>
            <a href="https://www.ovhcloud.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] transition-colors hover:underline">
              www.ovhcloud.com
            </a>
          </p>
        </div>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Propriété intellectuelle
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
          L'ensemble des contenus publiés sur ce site (textes, illustrations, code source) est la propriété exclusive de Pierrick Fonquerne, sauf mention contraire. Toute reproduction, même partielle, sans autorisation préalable est interdite.
        </p>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Données personnelles et analytique
        </p>
        <div class="space-y-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          <p>
            Ce site utilise <strong class="font-medium text-[var(--color-fg)]">Umami Analytics</strong>, un outil d'audience auto-hébergé, cookieless et conforme au RGPD. Aucun cookie n'est déposé sur votre navigateur. Les adresses IP ne sont pas conservées. Aucune donnée n'est transmise à des tiers.
          </p>
          <p>
            La mesure d'audience est anonyme et relève de l'exemption de consentement pour la mesure d'audience au sens de la recommandation de la CNIL. Elle est active par défaut. Vous pouvez vous y opposer à tout moment, de deux façons : en activant le réglage <strong class="font-medium text-[var(--color-fg)]">Do Not Track</strong> ou <strong class="font-medium text-[var(--color-fg)]">Global Privacy Control</strong> dans votre navigateur (respecté automatiquement), ou via le bouton ci-dessous.
          </p>
          <div class="pt-1">
            <button
              id="analytics-optout-btn"
              type="button"
              class="rounded-lg border border-[var(--color-line-strong)] px-4 py-1.5 text-sm text-[var(--color-fg-muted)] transition-colors duration-200 hover:bg-[var(--color-hover)]"
            >
              Chargement...
            </button>
          </div>
          <p>
            Conformément au RGPD et à la loi Informatique et Libertés, vous disposez d'un droit d'accès, de rectification et de suppression de vos données. Contact :
            <a href="mailto:contact@pierrickfonquerne.com" class="text-[var(--color-accent)] transition-colors hover:underline">
              contact@pierrickfonquerne.com
            </a>
          </p>
        </div>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Liens externes
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
          Ce site peut contenir des liens vers des sites tiers, fournis à titre informatif. Pierrick Fonquerne n'est pas responsable de leur contenu.
        </p>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Droit applicable
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
          Le présent site est soumis au droit français. En cas de litige, les tribunaux français seront seuls compétents.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>

<script>
  const UMAMI_DISABLED_KEY = 'umami.disabled';

  function updateButton() {
    const btn = document.getElementById('analytics-optout-btn') as HTMLButtonElement | null;
    if (!btn) return;
    let isOptedOut = false;
    try {
      isOptedOut = localStorage.getItem(UMAMI_DISABLED_KEY) === '1';
    } catch {
      /* localStorage unavailable */
    }
    if (isOptedOut) {
      btn.textContent = "Mesure d’audience : refusée. Réactiver.";
    } else {
      btn.textContent = "Mesure d’audience : active. Refuser.";
    }
  }

  // Event delegation - survives view transitions
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('#analytics-optout-btn')) return;
    try {
      const isOptedOut = localStorage.getItem(UMAMI_DISABLED_KEY) === '1';
      if (isOptedOut) {
        localStorage.removeItem(UMAMI_DISABLED_KEY);
      } else {
        localStorage.setItem(UMAMI_DISABLED_KEY, '1');
      }
    } catch {
      /* localStorage unavailable */
    }
    updateButton();
  });

  document.addEventListener('astro:page-load', updateButton);
  updateButton();
</script>
