---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
---

<BaseLayout title="Pierrick Fonquerne — Portfolio" current="/">
  <section class="mx-auto max-w-[1280px] px-14 py-24">
    <Eyebrow text="PORTFOLIO · v2026.05 · FR" />
    <h1
      class="font-display mt-14 text-[clamp(72px,12vw,180px)] leading-[0.85] font-extrabold tracking-[-0.06em] text-[var(--color-fg)] uppercase"
    >
      Pierrick<br />Fonquerne
    </h1>
    <p class="mt-9 max-w-[720px] text-[22px] leading-[1.45] text-[var(--color-fg-muted)]">
      Layout scaffold ready — hero, marquee and about section land in étape 3.
    </p>
  </section>
</BaseLayout>
