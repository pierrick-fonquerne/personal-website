---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../lib/i18n';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout title={t.legal.indexTitle} locale={locale}>
  <div class="container-page py-16 md:py-24">

    <header class="mb-16 max-w-2xl">
      <p class="mb-4 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
        Legal
      </p>
      <h1 class="mb-3 text-2xl font-semibold text-[var(--color-fg)]">
        {t.legal.indexTitle}
      </h1>
      <p class="text-sm text-[var(--color-fg-dim)]">Last updated: May 2026</p>
    </header>

    <div class="max-w-2xl space-y-14">

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Site publisher
        </p>
        <div class="space-y-1 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          <p>Pierrick Fonquerne</p>
          <p>Individual - Limoux, Aude, France</p>
          <p>
            Contact:
            <a href="mailto:contact@pierrickfonquerne.com" class="text-[var(--color-accent)] transition-colors hover:underline">
              contact@pierrickfonquerne.com
            </a>
          </p>
        </div>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Publication director
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">Pierrick Fonquerne</p>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Hosting
        </p>
        <div class="space-y-1 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          <p>OVH SAS - 2 rue Kellermann, 59100 Roubaix, France</p>
          <p>
            <a href="https://www.ovhcloud.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] transition-colors hover:underline">
              www.ovhcloud.com
            </a>
          </p>
        </div>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Intellectual property
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
          All content published on this site (text, illustrations, source code) is the exclusive property of Pierrick Fonquerne unless otherwise stated. Any reproduction, even partial, without prior authorization is prohibited.
        </p>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Personal data and analytics
        </p>
        <div class="space-y-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          <p>
            This site uses <strong class="font-medium text-[var(--color-fg)]">Umami Analytics</strong>, a self-hosted, cookieless, GDPR-compliant audience measurement tool. No cookie is placed in your browser. IP addresses are not retained. No data is shared with third parties.
          </p>
          <p>
            Audience measurement is anonymous and falls under the consent exemption for audience analytics. It is active by default. You may opt out at any time in two ways: by enabling the <strong class="font-medium text-[var(--color-fg)]">Do Not Track</strong> or <strong class="font-medium text-[var(--color-fg)]">Global Privacy Control</strong> setting in your browser (honored automatically), or via the button below.
          </p>
          <div class="pt-1">
            <button
              id="analytics-optout-btn"
              type="button"
              class="rounded-lg border border-[var(--color-line-strong)] px-4 py-1.5 text-sm text-[var(--color-fg-muted)] transition-colors duration-200 hover:bg-[var(--color-hover)]"
            >
              Loading...
            </button>
          </div>
          <p>
            In accordance with the GDPR, you have the right to access, correct, and delete your data. Contact:
            <a href="mailto:contact@pierrickfonquerne.com" class="text-[var(--color-accent)] transition-colors hover:underline">
              contact@pierrickfonquerne.com
            </a>
          </p>
        </div>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          External links
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
          This site may contain links to third-party websites, provided for informational purposes only. Pierrick Fonquerne is not responsible for their content.
        </p>
      </section>

      <section class="border-l-2 border-[var(--color-accent)] pl-5">
        <p class="mb-3 font-mono text-[11px] font-medium tracking-[0.16em] text-[var(--color-fg-dim)] uppercase">
          Applicable law
        </p>
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
          This site is governed by French law. In case of dispute, French courts will have sole jurisdiction.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>

<script>
  const UMAMI_DISABLED_KEY = 'umami.disabled';

  function updateButton() {
    const btn = document.getElementById('analytics-optout-btn') as HTMLButtonElement | null;
    if (!btn) return;
    let isOptedOut = false;
    try {
      isOptedOut = localStorage.getItem(UMAMI_DISABLED_KEY) === '1';
    } catch {
      /* localStorage unavailable */
    }
    if (isOptedOut) {
      btn.textContent = 'Analytics: disabled. Re-enable.';
    } else {
      btn.textContent = 'Analytics: active. Opt out.';
    }
  }

  // Event delegation - survives view transitions
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('#analytics-optout-btn')) return;
    try {
      const isOptedOut = localStorage.getItem(UMAMI_DISABLED_KEY) === '1';
      if (isOptedOut) {
        localStorage.removeItem(UMAMI_DISABLED_KEY);
      } else {
        localStorage.setItem(UMAMI_DISABLED_KEY, '1');
      }
    } catch {
      /* localStorage unavailable */
    }
    updateButton();
  });

  document.addEventListener('astro:page-load', updateButton);
  updateButton();
</script>
