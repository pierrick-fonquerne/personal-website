---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import { listCourses } from '../../../lib/courses';
import { localizedPath, useTranslations } from '../../../lib/i18n';
import { SUBTHEMES_BY_THEME, THEMES } from '../../../lib/taxonomy';
import { listTracks } from '../../../lib/tracks';
import CourseCard from '../../../components/courses/CourseCard.astro';
import CourseRail from '../../../components/courses/CourseRail.astro';
import { buildCourseNav } from '../../../lib/course-nav';

const locale = 'en' as const;
const t = useTranslations(locale);
const courses = await listCourses(locale);
const hasTracks = (await listTracks()).length > 0;

const groups = THEMES.map((theme) => ({
  theme,
  themeLabel: t.themes[theme],
  subthemes: SUBTHEMES_BY_THEME[theme]
    .map((sub) => ({
      sub,
      subLabel: t.subthemes[sub] ?? sub,
      courses: courses.filter((c) => c.data.theme === theme && c.data.subtheme === sub),
    }))
    .filter((s) => s.courses.length > 0),
})).filter((g) => g.subthemes.length > 0);

const navThemes = buildCourseNav(
  groups.map((group) => ({
    theme: group.theme,
    themeLabel: group.themeLabel,
    subthemes: group.subthemes.map((subtheme) => ({
      sub: subtheme.sub,
      subLabel: subtheme.subLabel,
      courseCount: subtheme.courses.length,
    })),
  })),
);
---

<BaseLayout
  title={`${t.courses.indexTitle} · Pierrick Fonquerne`}
  description={t.courses.indexLead}
  current="/interactive-courses"
  locale={locale}
>
  <section class="container-page py-16">
    <Eyebrow text={t.courses.eyebrow} />
    <h1
      class="font-display mt-4 text-[clamp(28px,6vw,44px)] leading-[1.1] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
    >
      {t.courses.indexTitle}
    </h1>
    <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-fg-muted)]">
      {t.courses.indexLead}
    </p>

    <aside
      class="mt-8 rounded-md border border-l-4 border-[var(--color-line)] border-l-[var(--color-accent)] bg-[var(--color-bg-elevated)] p-4 text-[13px] leading-relaxed text-[var(--color-fg-muted)]"
    >
      <p>
        <strong class="text-[var(--color-fg)]">About these courses.</strong>{' '}
        These courses, though carefully reviewed, originated as notes from discussions with various AI
        models. Subtle errors may have slipped through despite the review. If you spot one, please let
        me know: <a
          href="mailto:contact@pierrickfonquerne.com"
          class="underline hover:text-[var(--color-accent)]">contact@pierrickfonquerne.com</a
        >.
      </p>
      <p class="mt-3">
        The audio narrations that accompany the chapters are generated from a sample of my own
        voice, via Voxtral (Mistral AI). And please forgive my terrible French accent.
      </p>
    </aside>

    <div
      class="mt-16 lg:grid lg:grid-cols-[minmax(0,1fr)_210px] lg:items-start lg:gap-x-10"
    >
      <div class="space-y-24">
        {
          groups.map(({ theme, themeLabel, subthemes }) => (
            <section aria-labelledby={`theme-${theme}`} data-theme-section={theme}>
              <header class="mb-10 border-b border-[var(--color-line)] pb-4">
                <h2
                  id={`theme-${theme}`}
                  class="font-display text-[clamp(24px,5vw,36px)] leading-[1.15] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
                >
                  {themeLabel}
                </h2>
              </header>

              <div class="space-y-12">
                {subthemes.map(({ sub, subLabel, courses: subCourses }) => (
                  <div>
                    <h3
                      id={`sub-${sub}`}
                      class="mb-5 font-mono text-[12px] tracking-[0.18em] text-[var(--color-accent)] uppercase"
                    >
                      {subLabel}
                    </h3>
                    <ul class="grid gap-5 sm:grid-cols-1 lg:grid-cols-2">
                      {subCourses.map((course) => (
                        <li>
                          <CourseCard
                            href={localizedPath(`/interactive-courses/${course.data.slug}`, locale)}
                            level={course.data.level}
                            moduleCount={course.data.modules.length}
                            estimatedMinutes={course.data.estimatedMinutes}
                            title={course.data.title}
                            summary={course.data.summary}
                            tags={course.data.tags}
                            modulesUnit={t.courses.modulesUnit}
                            minutesUnit={t.courses.minutesUnit}
                          />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <CourseRail
        navThemes={navThemes}
        onThisPageLabel={t.courses.onThisPage}
        glossaryHref={localizedPath('/glossary', locale)}
        glossaryLabel={t.courses.glossaryLink}
        tracksHref={hasTracks ? localizedPath('/tracks', locale) : undefined}
        tracksLabel={t.courses.tracksLink}
      />
    </div>
  </section>
</BaseLayout>
