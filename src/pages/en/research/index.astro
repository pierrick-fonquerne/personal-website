---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import ResearchIntro from '../../../components/research/ResearchIntro.astro';
import ResearchList from '../../../components/research/ResearchList.astro';
import RecentJournal from '../../../components/research/RecentJournal.astro';
import { useTranslations } from '../../../lib/i18n';
import { resolveProgram } from '../../../lib/programs';
import { recentJournalEntries } from '../../../lib/research-journal';
import ResearchBackdrop from '../../../components/research/ResearchBackdrop.astro';

const locale = 'en' as const;
const t = useTranslations(locale);
const entries = (await getCollection('research')).filter((e) => e.data.published);
const projectEntries = (await getCollection('projects')).filter((e) => e.data.published);
const programs = (await getCollection('programs'))
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug))
  .map((program) => resolveProgram(program, entries, projectEntries));

const publishedResearchSlugs = new Set(entries.map((entry) => entry.data.slug));
const journalAll = await getCollection('research-journal');
const recentEntries = recentJournalEntries(journalAll, publishedResearchSlugs, 3);
const researchTitles = new Map(entries.map((entry) => [entry.data.slug, entry.data[locale].title]));
---

<BaseLayout
  title={`${t.research.indexTitle} · Pierrick Fonquerne`}
  description="Field notebook by Pierrick Fonquerne: deep dives, paper syntheses and technical explorations."
  current="/research"
  locale={locale}
>
  <ResearchBackdrop />
  <section class="container-page py-16">
    <Eyebrow text={t.research.eyebrow} />
    <h1
      class="font-display mt-4 text-[clamp(28px,6vw,44px)] leading-[1.1] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
    >
      {t.research.indexTitle}
    </h1>
    <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-fg-muted)]">
      {t.research.lead}
    </p>

    <div class="mt-12">
      <ResearchIntro locale={locale} />
    </div>

    <div class="mt-16">
      <RecentJournal entries={recentEntries} researchTitles={researchTitles} locale={locale} />
    </div>

    <div class="mt-20">
      <ResearchList entries={entries} programs={programs} locale={locale} />
    </div>
  </section>
</BaseLayout>
