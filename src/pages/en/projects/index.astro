---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import ProjectsList from '../../../components/projects/ProjectsList.astro';
import { useTranslations } from '../../../lib/i18n';

const locale = 'en' as const;
const t = useTranslations(locale);
const projects = (await getCollection('projects')).filter((p) => p.data.published);
---

<BaseLayout
  title={`${t.projects.indexTitle} · Pierrick Fonquerne`}
  description="A selection of software projects by Pierrick Fonquerne: entrepreneurship, open source, games, experiments."
  current="/projects"
  locale={locale}
>
  <section class="mx-auto max-w-[1280px] px-6 py-16 lg:px-14">
    <Eyebrow text={t.projects.eyebrow} />
    <h1
      class="mt-4 font-display text-[44px] leading-[1.05] font-bold tracking-[-0.02em] text-[var(--color-fg)]"
    >
      {t.projects.indexTitle}
    </h1>
    <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-fg-muted)]">
      {t.projects.lead}
    </p>

    <div class="mt-20">
      <ProjectsList projects={projects} locale={locale} />
    </div>
  </section>
</BaseLayout>
